{
  "name": "gitlab-bot",
  "version": "1.2.0",
  "description": "GitLab bot that interconnect GitLab with Telegram",
  "main": "src/index.js",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "start": "node --no-network-family-autoselection .",
    "lint": "eslint src --ext .js",
    "fix": "eslint src --ext .js --fix",
    "format": "prettier --check \"**/*.{js,ts}\"",
    "format:fix": "prettier --write \"**/*.{js,ts}\"",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.melroy.org:melroy/gitlab-bot.git"
  },
  "keywords": [
    "bot",
    "telegram",
    "gitlab",
    "chat",
    "issues",
    "pipeline",
    "release",
    "merge requests"
  ],
  "author": {
    "name": "Melroy van den Berg",
    "email": "melroy@melroy.org"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "node-telegram-bot-api": "^2.3.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "neostandard": "^0.14.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10"
  }
}
